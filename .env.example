# ============================================================
# AuraWell AI - environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (or local docker mongo for development)
MONGODB_URI=mongodb://localhost:27017/aurawell
# Long random string used to sign session cookies (required in production)
SESSION_SECRET=replace-with-at-least-32-random-characters
# Comma separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173
# Trust proxy count when deployed behind a reverse proxy (0 = disabled)
TRUST_PROXY=0

# ---- AI provider (optional) ----
# When AI_API_KEY is empty the server uses deterministic fallback responses.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---- Client (VITE_ prefixed values are exposed to the browser) ----
VITE_API_BASE_URL=/api
