# ============================================================
# AuraWell AI - Production Environment Configuration
# Set these variables on your hosting provider (Render, Railway, etc.)
# ============================================================

# ---- Server Configuration ----
NODE_ENV=production
PORT=4000

# MongoDB Atlas connection string (Free cluster at https://cloud.mongodb.com)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/aurawell?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/aurawell?retryWrites=true&w=majority

# At least 32 random characters used to sign session cookies
SESSION_SECRET=e7bf859a2c3149a4ba1f3918b82435dc745e6914569e20a4b3d7560e9c8a14b2

# Allowed browser origin(s) - comma separated.
# For unified deployment (Express serves React): leave as self or your live domain
# Example: https://aurawell-ai.onrender.com,https://aurawell.vercel.app
CLIENT_ORIGIN=https://aurawell-ai.onrender.com

# Reverse proxy hops (Render/Vercel/Railway use 1)
TRUST_PROXY=1

# Cookie SameSite policy: 'lax' for unified domain, 'none' for cross-domain
SESSION_COOKIE_SAME_SITE=lax

# ---- AI Provider (Optional) ----
# When AI_API_KEY is omitted, AuraWell operates with built-in deterministic wellness fallbacks.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
